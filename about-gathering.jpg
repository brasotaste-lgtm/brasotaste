@import "tailwindcss" source(none);
@source "../src";
@import "tw-animate-css";
@import "@fontsource/montserrat/300.css";
@import "@fontsource/montserrat/400.css";
@import "@fontsource/montserrat/500.css";
@import "@fontsource/montserrat/600.css";
@import "@fontsource/montserrat/700.css";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --font-sans: "Montserrat", system-ui, sans-serif;
  --font-display: "Montserrat", system-ui, sans-serif;

  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);

  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);

  --color-brand-navy: var(--brand-navy);
  --color-brand-navy-deep: var(--brand-navy-deep);
  --color-brand-gold: var(--brand-gold);
  --color-brand-gold-soft: var(--brand-gold-soft);
  --color-brand-cream: var(--brand-cream);
  --color-brand-cream-deep: var(--brand-cream-deep);

  --shadow-gold-glow: 0 10px 40px -10px color-mix(in oklab, var(--brand-gold) 45%, transparent);
  --shadow-elegant: 0 30px 60px -30px color-mix(in oklab, var(--brand-navy) 40%, transparent);
}

:root {
  --radius: 0.25rem;

  /* Brand */
  --brand-navy: oklch(0.34 0.07 260);          /* #2A4069 */
  --brand-navy-deep: oklch(0.22 0.05 260);
  --brand-gold: oklch(0.79 0.10 78);            /* #E2BD7C */
  --brand-gold-soft: oklch(0.88 0.06 80);
  --brand-cream: oklch(0.97 0.012 75);          /* #FAF6F1 */
  --brand-cream-deep: oklch(0.93 0.015 75);

  /* Semantic mappings — light editorial */
  --background: var(--brand-cream);
  --foreground: var(--brand-navy-deep);
  --card: oklch(1 0 0);
  --card-foreground: var(--brand-navy-deep);
  --popover: oklch(1 0 0);
  --popover-foreground: var(--brand-navy-deep);
  --primary: var(--brand-navy);
  --primary-foreground: var(--brand-cream);
  --secondary: var(--brand-cream-deep);
  --secondary-foreground: var(--brand-navy);
  --muted: var(--brand-cream-deep);
  --muted-foreground: oklch(0.45 0.03 260);
  --accent: var(--brand-gold);
  --accent-foreground: var(--brand-navy-deep);
  --destructive: oklch(0.55 0.20 27);
  --destructive-foreground: oklch(0.98 0 0);
  --border: oklch(0.88 0.015 75);
  --input: oklch(0.90 0.015 75);
  --ring: var(--brand-gold);
}

@layer base {
  * {
    border-color: var(--color-border);
  }
  html {
    scroll-behavior: smooth;
    font-size: 105%;
  }
  @media (min-width: 768px) {
    html { font-size: 100%; }
  }
  @media (min-width: 1280px) {
    html { font-size: 100%; }
  }

  body {
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-sans);
    font-weight: 400;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  h1, h2, h3, h4, h5 {
    font-family: var(--font-display);
    letter-spacing: -0.01em;
  }
}

@utility eyebrow {
  font-size: 0.72rem;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  font-weight: 500;
  color: var(--brand-gold);
}

@utility gold-divider {
  display: inline-block;
  width: 48px;
  height: 1px;
  background: var(--brand-gold);
}

@utility hover-gold-glow {
  transition: transform 500ms ease, box-shadow 500ms ease;
  &:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-gold-glow);
  }
}

/* Smoke / ember keyframes */
@keyframes smoke-rise {
  0%   { transform: translate3d(0,0,0) scale(1);   opacity: 0; }
  20%  { opacity: 0.5; }
  100% { transform: translate3d(var(--dx,0), -120vh, 0) scale(2.2); opacity: 0; }
}
@keyframes ember-float {
  0%   { transform: translate3d(0,0,0); opacity: 0; }
  15%  { opacity: 1; }
  100% { transform: translate3d(var(--dx,0), -90vh, 0); opacity: 0; }
}
@keyframes fade-up {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}

.animate-fade-up { animation: fade-up 0.9s ease-out both; }

/* Horizontal interaction remains available without browser scrollbars. */
.experience-carousel {
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.experience-carousel::-webkit-scrollbar {
  display: none;
}
